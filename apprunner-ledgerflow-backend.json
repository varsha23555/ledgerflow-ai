{
"ServiceName": "ledgerflow-ai-backend",
  "SourceConfiguration": {
    "CodeRepository": {
      "RepositoryUrl": "https://github.com/varsha23555/ledgerflow-ai",
      "SourceCodeVersion": {
        "Type": "BRANCH",
        "Value": "master"
      },
      "CodeConfiguration": {
        "ConfigurationSource": "REPOSITORY",
        "CodeConfigurationValues": {
          "Runtime": "PYTHON_3",
          "BuildCommand": "pip install -r requirements.txt",
          "StartCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT",
          "Port": "8000",
          "RuntimeEnvironmentVariables": {
            "DATABASE_URL": "postgresql+asyncpg://ledgerflow:ledgerflow@ledgerflow-db.ckn2es6uqf72.us-east-1.rds.amazonaws.com:5432/ledgerflow",
            "SECRET_KEY": "ledgerflow-secret",
            "FRONTEND_ORIGIN": "https://ledgerflow-ai-frontend.us-east-1.awsapprunner.com"
          }
        }
      },
      "SourceDirectory": "backend"
    },
    "AuthenticationConfiguration": {
      "ConnectionArn": "arn:aws:apprunner:us-east-1:929453768266:connection/sift-github-connection/f2a76e07cde7445781367cac110feec5"
    },
    "AutoDeploymentsEnabled": true
  },
  "InstanceConfiguration": {
    "Cpu": "1024",
    "Memory": "2048"
  },
  "NetworkConfiguration": {
    "IngressConfiguration": {
      "IsPubliclyAccessible": true
    },
    "EgressConfiguration": {
      "EgressType": "DEFAULT"
    }
  }
}