{
"ServiceName": "ledgerflow-ai-frontend-apprunner",
  "SourceConfiguration": {
    "CodeRepository": {
      "RepositoryUrl": "https://github.com/varsha23555/ledgerflow-ai",
      "SourceCodeVersion": {
        "Type": "BRANCH",
        "Value": "master"
      },
      "CodeConfiguration": {
        "ConfigurationSource": "REPOSITORY",
        "CodeConfigurationValues": {
          "Runtime": "NODEJS_18",
          "BuildCommand": "npm install && npm run build",
          "StartCommand": "npx serve -s dist -l $PORT",
          "Port": "3000",
          "EnvironmentVariables": [
            {
              "Name": "VITE_API_URL",
              "Value": "https://ledgerflow-ai-backend.us-east-1.awsapprunner.com"
            },
            {
              "Name": "NODE_ENV",
              "Value": "production"
            }
          ]
        }
      },
      "SourceDirectory": "frontend"
    },
    "AuthenticationConfiguration": {
      "ConnectionArn": "arn:aws:apprunner:us-east-1:929453768266:connection/sift-github-connection/f2a76e07cde74457881367cac110feec5"
    },
    "AutoDeploymentsEnabled": true
  },
  "InstanceConfiguration": {
    "Cpu": "1024",
    "Memory": "2048"
  },
  "NetworkConfiguration": {
    "IngressConfiguration": {
      "IsPubliclyAccessible": true
    },
    "EgressConfiguration": {
      "EgressType": "DEFAULT"
    }
  }
}